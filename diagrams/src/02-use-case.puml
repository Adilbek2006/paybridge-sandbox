@startuml use-case
title PayBridge — Use Case Diagram
skinparam defaultFontName DejaVu Sans
skinparam shadowing false
note "The payer interacts only with provider-hosted\npages (see System Context diagram)" as N1
left to right direction

actor "Merchant developer\n(client system)" as Dev
actor "Administrator" as Admin
actor "Payment provider\n(Stripe / PayPal / Mock)" as PSP

rectangle "PayBridge" {
  usecase "UC1 Create payment\n(FR-03, FR-07)" as UC1
  usecase "UC2 Apply idempotency key\n(FR-08)" as UC2
  usecase "UC3 Get / list payments\n(FR-04, FR-05)" as UC3
  usecase "UC4 Cancel payment\n(FR-06)" as UC4
  usecase "UC5 Refund payment\n(FR-14)" as UC5
  usecase "UC6 Register webhook endpoint\n(FR-12)" as UC6
  usecase "UC7 Receive & verify\nprovider webhook (FR-10, FR-11)" as UC7
  usecase "UC8 Deliver signed notification\nwith retries (FR-12, FR-13)" as UC8
  usecase "UC9 Run mock scenario\n(FR-09)" as UC9
  usecase "UC10 Manage merchants &\nAPI keys (FR-01)" as UC10
  usecase "UC11 Monitor payments &\ndeliveries, resend (FR-16)" as UC11
  usecase "UC12 Export report (CSV)\n(FR-17)" as UC12
}

Dev --> UC1
Dev --> UC3
Dev --> UC4
Dev --> UC5
Dev --> UC6
Dev --> UC9
UC1 ..> UC2 : <<include>>
UC4 ..> UC2 : <<include>>
UC5 ..> UC2 : <<include>>
UC7 ..> UC8 : <<include>>
UC9 ..> UC7 : <<include>>
Admin --> UC10
Admin --> UC11
Admin --> UC12
PSP --> UC7
@enduml
